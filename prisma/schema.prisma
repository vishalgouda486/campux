generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id         String @id @default(cuid())
  name       String
  email      String @unique
  department String
  semester   Int

  attendance Attendance[]
  marks      Mark[]

  attendanceRecords AttendanceRecord[]

  createdAt DateTime @default(now())
}

model Faculty {
  id String @id @default(cuid())

  name  String
  email String @unique

  department String

  designation String?

  specialization String?

  isTeaching Boolean @default(true)

  subjects Subject[]

  timetables Timetable[]

  loads FacultyLoad[]

  createdAt DateTime @default(now())
}

model Subject {
  id String @id @default(cuid())

  name String

  code String?

  semester Int

  type String

  weeklyHours Int

  facultyId String?

  faculty Faculty? @relation(fields: [facultyId], references: [id])

  marks      Mark[]
  attendance Attendance[]

  attendanceRecords AttendanceRecord[]

  timetables Timetable[]
}

model Attendance {
  id String @id @default(cuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  percentage Float
}

model Mark {
  id String @id @default(cuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  internal   Float
  assignment Float
}

model AttendanceRecord {
  id String @id @default(cuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  date DateTime @default(now())

  status String
}

model Timetable {
  id String @id @default(cuid())

  day String

  period Int

  startTime String
  endTime   String

  classroom String

  roomType String @default("CLASSROOM")

  semester   Int
  department String

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id])

  createdAt DateTime @default(now())
}

model UserRole {
  id String @id @default(cuid())

  email String @unique

  role String

  createdAt DateTime @default(now())
}

model User {
  id String @id @default(cuid())

  name String

  email String @unique

  password String

  role String

  createdAt DateTime @default(now())
}

model Classroom {
  id String @id @default(cuid())

  roomNumber String @unique

  isLab Boolean @default(false)

  createdAt DateTime @default(now())
}

model FacultyLoad {
  id String @id @default(cuid())

  facultyId String

  faculty Faculty @relation(fields: [facultyId], references: [id])

  day String

  totalClasses Int

  createdAt DateTime @default(now())
}
